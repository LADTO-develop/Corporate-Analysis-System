# ---------------------------------------------------------------------------
# Borderline Firm Detector — .gitignore
# ---------------------------------------------------------------------------

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Virtual envs ----------------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Package managers ------------------------------------------------------
pip-log.txt
pip-delete-this-directory.txt
uv.lock
poetry.lock

# --- Environment variables -------------------------------------------------
.env
.env.*

# --- Jupyter ---------------------------------------------------------------
.ipynb_checkpoints/
notebooks/**/*.html
notebooks/**/*_files/

# --- Data ------------------------------------------------------------------
# Large raw/interim/processed data is local or regenerated unless explicitly
# whitelisted below. This repository does not currently use DVC or Git LFS.
data/raw/**/
data/interim/**/
data/processed/**/
!data/**/README.md
!data/raw/ts2000/
!data/raw/ts2000/README.md
!data/raw/ts2000/TS2000_Credit_Model_Dataset_Model_V1.csv
!data/raw/ts2000/feature_46_inference_2026_aux.csv
!data/raw/macro/
!data/raw/macro/README.md
!data/raw/macro/ECOS_Macro_Processed.csv
# External mapping tables ARE tracked (small, versioned reference data).
!data/external/**
data/external/opendart/**

# --- Model artifacts -------------------------------------------------------
*.ckpt
*.pt
*.pth
*.joblib
*.pkl
*.h5
mlruns/
lightning_logs/
wandb/

# --- Hydra / experiment output --------------------------------------------
/outputs/
!data/outputs/
data/outputs/**
!data/outputs/README.md

# Output policy:
# - Keep the runtime baseline artifact needed by the dashboard/CLI.
# - Keep curated, small diagnostics that teams use to review baseline results.
# - Treat dashboards, reports, large row-level scores, repeated live batches,
#   and nested experiment directories as regenerated files or release artifacts.
!data/outputs/modeling/
!data/outputs/modeling/feature_46_xgboost/
!data/outputs/modeling/feature_46_xgboost/README.md
!data/outputs/modeling/feature_46_xgboost/model_artifact_metadata.json
!data/outputs/modeling/feature_46_xgboost/xgboost_model.json
!data/outputs/modeling/feature_46_xgboost/diagnostics/
data/outputs/modeling/feature_46_xgboost/diagnostics/**
!data/outputs/modeling/feature_46_xgboost/diagnostics/README.md
!data/outputs/modeling/feature_46_xgboost/diagnostics/*.csv
!data/outputs/modeling/feature_46_xgboost/diagnostics/*.json
!data/outputs/modeling/feature_46_xgboost/diagnostics/*.md
!data/outputs/modeling/feature_46_xgboost/diagnostics/stage2_agents/
!data/outputs/modeling/feature_46_xgboost/diagnostics/stage2_agents/feature46_full_review_trigger_73_harness/
!data/outputs/modeling/feature_46_xgboost/diagnostics/stage2_agents/feature46_full_review_trigger_73_harness/**
!data/outputs/modeling/feature_45_robust_candidate/
data/outputs/modeling/feature_45_robust_candidate/**
!data/outputs/modeling/feature_45_robust_candidate/README.md
!data/outputs/modeling/feature_45_robust_candidate/model_artifact_metadata.json
!data/outputs/modeling/feature_45_robust_candidate/xgboost_model.json
!data/outputs/modeling/feature_45_robust_candidate/diagnostics/
data/outputs/modeling/feature_45_robust_candidate/diagnostics/**
!data/outputs/modeling/feature_45_robust_candidate/diagnostics/feature_45_robust_candidate_2026_feature_readiness.csv
!data/outputs/modeling/feature_45_robust_candidate/diagnostics/feature_45_robust_candidate_evaluation_report.md
!data/outputs/modeling/feature_45_robust_candidate/diagnostics/feature_45_robust_candidate_evaluation_summary.json
!data/outputs/modeling/feature_45_robust_candidate/diagnostics/feature_45_robust_candidate_segment_comparison.csv
!data/outputs/modeling/feature_45_robust_candidate/diagnostics/feature_45_robust_candidate_segment_metrics.csv
multirun/
.hydra/
logs/

