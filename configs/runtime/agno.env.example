# CAS Stage 2 Agno live-mode environment example
#
# Usage from the repository root:
#   copy configs\runtime\agno.env.example .env
#   edit .env and fill ANTHROPIC_API_KEY
#   C:\Users\gho32\anaconda3\envs\cap_env\python.exe scripts\check_agno_stage2.py
#   C:\Users\gho32\anaconda3\envs\cap_env\python.exe scripts\run_agent.py --company-id 000250 --market KOSDAQ --analysis-year 2026
#
# The dashboard can be launched in Agno mode with:
#   C:\Users\gho32\anaconda3\envs\cap_env\python.exe scripts\run_credit_dashboard.py --stage2-runner agno --strict-agno

CAS_STAGE2_RUNNER=agno
CAS_DASHBOARD_STAGE2_RUNNER=agno
CAS_STAGE2_MODEL=claude-sonnet-4-5-20250929
CAS_STAGE2_MAX_TOKENS=6000
CAS_STAGE2_FALLBACK_ON_ERROR=0

# Required for live Agno/Claude calls. Never commit a real key.
ANTHROPIC_API_KEY=

# Optional live evidence collection. Leave off unless provider keys are ready.
CAS_ENABLE_EXTERNAL_EVIDENCE=0
OPENDART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
TAVILY_API_KEY=
