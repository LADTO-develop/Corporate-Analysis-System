# Corporate Analysis System environment template

# Core runtime
CAS_ENV=local
CAS_LOG_LEVEL=INFO
CAS_RANDOM_SEED=42
CAS_TORCH_DETERMINISTIC=0

# External data / model providers
# Leave these blank in committed files. Put real values only in local .env
# files or a secret manager, and never paste them into PRs or issues.
ECOS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
OPENDART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
TAVILY_API_KEY=

# Stage 2 evidence collection is off by default so CI/local runs stay deterministic.
# Set to 1 only for local demos that should call Naver/Tavily/OpenDART.
CAS_ENABLE_EXTERNAL_EVIDENCE=0

# Stage 2 agent runner. Keep deterministic for CI/offline runs.
# Set CAS_STAGE2_RUNNER=agno only after installing Agno and configuring ANTHROPIC_API_KEY.
CAS_STAGE2_RUNNER=deterministic
CAS_STAGE2_MODEL=claude-sonnet-4-5-20250929
CAS_STAGE2_MAX_TOKENS=6000

# Optional storage / app integration
DATABASE_URL=
EXTERNAL_API_BASE_URL=
OUTPUT_DIR=data/outputs

# Backward-compatible legacy keys
# BFD_LOG_LEVEL=INFO
# BFD_RANDOM_SEED=42
# BFD_TORCH_DETERMINISTIC=0
