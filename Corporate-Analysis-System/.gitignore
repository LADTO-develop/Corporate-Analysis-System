# ---------------------------------------------------------------------------
# Borderline Firm Detector — .gitignore
# ---------------------------------------------------------------------------

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Virtual envs ----------------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Package managers ------------------------------------------------------
pip-log.txt
pip-delete-this-directory.txt
uv.lock
poetry.lock

# --- Environment variables -------------------------------------------------
.env
.env.*
!.env.example

# --- Jupyter ---------------------------------------------------------------
.ipynb_checkpoints/
notebooks/**/*.html
notebooks/**/*_files/

# --- Data ------------------------------------------------------------------
# All raw/interim/processed data is tracked via DVC or LFS, not git.
data/raw/**/
data/interim/**/
data/processed/**/
!data/**/.gitkeep
!data/**/README.md
!data/raw/ts2000/
!data/raw/ts2000/README.md
!data/raw/ts2000/TS2000_Credit_Model_Dataset_Model_V1.csv
# External mapping tables ARE tracked (small, versioned reference data).
!data/external/**

# --- Model artifacts -------------------------------------------------------
*.ckpt
*.pt
*.pth
*.joblib
*.pkl
*.h5
mlruns/
lightning_logs/
wandb/

# --- Hydra / experiment output --------------------------------------------
outputs/
!data/outputs/
data/outputs/**
!data/outputs/README.md
!data/outputs/modeling/
!data/outputs/modeling/feature_43_xgboost/
!data/outputs/modeling/feature_43_xgboost/README.md
!data/outputs/modeling/feature_43_xgboost/model_artifact_metadata.json
!data/outputs/modeling/feature_43_xgboost/xgboost_model.json
!data/outputs/modeling/feature_43_xgboost/diagnostics/
!data/outputs/modeling/feature_43_xgboost/diagnostics/*.csv
!data/outputs/modeling/feature_43_xgboost/diagnostics/*.json
!data/outputs/modeling/feature_43_xgboost/diagnostics/*.md
multirun/
.hydra/

# --- TabPFN model cache ---------------------------------------------------
# Default location; TABPFN_MODEL_CACHE_DIR env var can override.
.cache/tabpfn/

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE -------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --- Claude / AI assistants -----------------------------------------------
.claude/
.cursor/
CLAUDE.md
