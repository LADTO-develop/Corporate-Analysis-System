# --- [3-4] 마스터 파이프라인 실행 로직 ---
class AgnoErrorInterceptor(logging.Handler):
    def __init__(self):
        super().__init__()
        self.has_error = False
        self.error_messages = []
    def emit(self, record):
        if record.levelno >= logging.ERROR:
            self.has_error = True
            self.error_messages.append(record.getMessage())

def run_master_pipeline(company_name: str, stock_code: str, initial_rating: int, data_summary: str):
    print("="*70)
    print(f"🚀 [{company_name}] 3단계 마스터 신용평가 파이프라인 가동 (ML 초기: {initial_rating}단계)")
    print("="*70)

    error_catcher = AgnoErrorInterceptor()
    target_loggers = [logging.getLogger(), logging.getLogger("agno"), logging.getLogger("httpx")]
    for logger in target_loggers:
        logger.addHandler(error_catcher)

    try:
        # [STEP 1] Data Analyst (재무 분석 및 HITL)
        print("\n🔍 [Step 1] Data_Analyst_Pro (재무 심층 분석 중...)")
        query_1 = f"Company: '{company_name}', ML 초기 등급: {initial_rating}단계. 데이터: {data_summary}"

        response_1 = data_analyst_agent.run(query_1)
        if error_catcher.has_error: raise ValueError(f"Step 1 에러: {error_catcher.error_messages[0]}")

        analyst_result = response_1.content
        adjusted_rating = analyst_result.adjusted_rating
        final_data_rating = adjusted_rating

        # HITL 개입
        if abs(initial_rating - adjusted_rating) >= 2:
            print(f"\n🚨 [HITL 경고] 2단계 이상 변동 감지 (초기 {initial_rating} -> 조정 {adjusted_rating})")
            print(f"사유: {analyst_result.adjustment_reason}")
            while True:
                user_input = input("위 조정을 승인하시겠습니까? (Y/N): ")
                if user_input.strip().upper() == 'Y':
                    print("✅ 승인 완료.")
                    break
                elif user_input.strip().upper() == 'N':
                    print("🚫 기각. 초기 등급 유지.")
                    final_data_rating = initial_rating
                    break
        else:
            print(f"✅ 안정적인 재무 등급 도출: {final_data_rating}단계")

        # [STEP 2] Risk Researcher (비재무 외부 리스크 크롤링)
        print("\n🔍 [Step 2] Risk_Research_Pro (DART/뉴스 리스크 크롤링 중...)")
        error_catcher.has_error, error_catcher.error_messages = False, []

        query_2 = f"'{company_name}'({stock_code})의 최근 6개월 비재무적 리스크를 검색해 요약해."
        response_2 = risk_research_agent.run(query_2)
        if error_catcher.has_error: raise ValueError(f"Step 2 에러: {error_catcher.error_messages[0]}")

        research_summary = response_2.content
        print("✅ 외부 리스크 탐색 완료.")

        # [STEP 3] Manager Agent (최종 판정)
        print("\n⚖️ [Step 3] Manager_Pro (최종 신용등급 심의 중...)")
        error_catcher.has_error, error_catcher.error_messages = False, []

        query_3 = (
            f"1단계 재무 심사 확정 등급: {final_data_rating}단계\n"
            f"1단계 재무 분석 요약: {analyst_result.analysis_report}\n"
            f"2단계 외부 리스크 리서치 결과:\n{research_summary}\n\n"
            f"위 자료를 바탕으로 비토권 발동 여부를 심사하고 최종 등급과 투자 심의 보고서를 작성해."
        )

        response_3 = manager_agent.run(query_3)
        if error_catcher.has_error: raise ValueError(f"Step 3 에러: {error_catcher.error_messages[0]}")

        manager_result = response_3.content

        print("\n" + "★"*70)
        print(f"🏆 [{company_name}] 최종 신용평가 심의 결과")
        print("★"*70)
        print(f" - ML 초기 통계 등급: {initial_rating}단계")
        print(f" - Data Analyst 확정 등급: {final_data_rating}단계")
        print(f" - Manager 최종 확정 등급: {manager_result.final_rating}단계")
        if manager_result.veto_triggered:
            print(" 🚨 [주의] 중대 리스크로 인한 매니저 비토권(Veto) 발동됨!")
        print("\n[Executive Summary]")
        print(manager_result.executive_summary)

    except Exception as e:
        print(f"\n🚨 파이프라인 치명적 오류 발생 중단: {e}")
    finally:
        for logger in target_loggers: logger.removeHandler(error_catcher)

