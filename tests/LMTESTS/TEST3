# 1. Data Analyst 용 스키마
class FinancialAnalysisOutput(BaseModel):
    adjusted_rating: int = Field(description="LLM이 조정한 최종 등급 (1=매우적격 ~ 4=매우부적격)")
    adjustment_reason: str = Field(description="등급 조정 사유 (2단계 이상 변동 시 극단적 백분위 근거 포함, 변동 없으면 '특이사항 없음')")
    analysis_report: str = Field(description="[기업 개요] - [핵심 재무 지표 분석] - [초기 신용 평가 논리] 3단 구조 보고서")

# 2. Manager 용 스키마 (최종 판정용)
class FinalManagerOutput(BaseModel):
    final_rating: int = Field(description="매니저가 최종 확정한 신용 등급 (1~4)")
    veto_triggered: bool = Field(description="리서치 결과 치명적 리스크로 인해 비토권(강제 강등)이 발동되었는지 여부")
    executive_summary: str = Field(description="정량적 재무 분석과 정성적 외부 리스크를 융합한 최종 투자 심의 보고서 (마크다운)")

