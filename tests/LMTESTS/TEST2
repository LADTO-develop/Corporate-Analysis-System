        "제공된 `search_integrated_risk` 도구를 사용하여 기업명과 종목코드로 치명적 리스크를 검색하세요.",
        "DART 공시 원문을 최우선으로 신뢰하며, 주가 전망(노이즈)은 배제하고 팩트 기반의 리스크 요약 보고서를 작성하세요."
    ]
)

# --- [3-3] 보수된 2중 분석 파이프라인 실행 함수 (HITL + Logging Interceptor 적용) ---
class AgnoErrorInterceptor(logging.Handler):
    """Agno 프레임워크가 몰래 흡수하는 백그라운드 에러 로그를 낚아챕니다."""
    def __init__(self):
        super().__init__()
        self.has_error = False
        self.error_messages = []

    def emit(self, record):
        if record.levelno >= logging.ERROR:
            self.has_error = True
            self.error_messages.append(record.getMessage())

def run_dual_analysis_pipeline(company_name: str, stock_code: str, initial_rating: int, data_summary: str):
    print("="*60)
    print(f"🚀 [{company_name}] 2중 정성 분석 파이프라인 가동 (ML 초기 등급: {initial_rating}단계)")
    print("="*60)

    # 💡 에러 인터셉터 장착 (루트 및 Agno 관련 로거)
    error_catcher = AgnoErrorInterceptor()
    target_loggers = [logging.getLogger(), logging.getLogger("agno"), logging.getLogger("httpx")]
    for logger in target_loggers:
        logger.addHandler(error_catcher)

    try:
        # [STEP 1] Data Analyst 분석 및 등급 조정 (OpenAI)
        print("\n🔍 [Step 1] Data_Analyst_Pro (OpenAI) 재무 데이터 심층 분석 중...")
        query_1 = f"Company: '{company_name}', ML 초기 등급: {initial_rating}단계. 데이터 요약: {data_summary}"

        response = data_analyst_agent.run(query_1)

        # 💡 API 에러 1차 감지
        if error_catcher.has_error:
            raise ValueError(f"OpenAI 시스템 에러 탐지: {error_catcher.error_messages[0]}")

        analyst_result = response.content
        adjusted_rating = analyst_result.adjusted_rating
        rating_diff = abs(initial_rating - adjusted_rating)
        final_data_rating = adjusted_rating

        # [HITL 로직] 2단계 이상 변동 시 사용자 승인
        if rating_diff >= 2:
            print(f"\n🚨 [경고] 2단계 이상 등급 변동 감지 (초기 {initial_rating} -> 조정 {adjusted_rating})")
            print("\n[긴급 등급 조정 사유서]")
            print(analyst_result.adjustment_reason)
            print("-" * 50)

            while True:
                user_input = input("\n위 조정을 승인하시겠습니까? (Y: 승인 / N: 기각 / 텍스트: 재분석): ")
                if user_input.strip().upper() == 'Y':
                    print("✅ 승인 완료.")
                    break
                elif user_input.strip().upper() == 'N':
                    print("🚫 기각. 초기 등급 유지.")
                    final_data_rating = initial_rating
                    break
                elif user_input.strip() != '':
                    print(f"🔄 '{user_input}' (현재는 기각으로 처리됩니다.)")
                    final_data_rating = initial_rating
                    break
        else:
            print(f"✅ 안정적인 등급 변동 (초기 {initial_rating} -> 조정 {adjusted_rating}).")

        # [STEP 2] Risk Researcher 크롤링 분석 (Claude)
        print("\n\n🔍 [Step 2] Risk_Research_Pro (Claude) 외부 리스크(DART/뉴스) 크롤링 중...\n")
        query_2 = f"기업명 '{company_name}', 종목코드 '{stock_code}'의 최근 6개월 비재무적 리스크를 검색해줘."

        # 이전 인터셉터 기록 초기화
        error_catcher.has_error = False
        error_catcher.error_messages.clear()

        risk_research_agent.print_response(query_2, stream=True)

        # 💡 API 에러 2차 감지 (Claude 404/429 등 방어)
        if error_catcher.has_error:
            raise ValueError(f"Claude 시스템 에러 탐지: {error_catcher.error_messages[0]}")

        print("\n" + "="*60)
        print(f"🎯 [파이프라인 중간 결과 요약]")
        print(f" - ML 초기 등급: {initial_rating}단계")
        print(f" - Data Analyst 확정 등급: {final_data_rating}단계")
        print(f" - Research Agent 오프밸런스 리스크 탐지 완료")
        print("="*60)

    except Exception as e:
        print(f"\n🚨 파이프라인 치명적 오류 발생 중단: {e}")
        print("API 키 한도, 네트워크 상태, 모델 접근 권한을 확인하세요.")
    finally:
        # 안전한 메모리 관리를 위해 인터셉터 제거
        for logger in target_loggers:
            logger.removeHandler(error_catcher)

