### 클로드 키 API 테스트용 코드

def test_claude_api():
    print("🔍 클로드 API 통신 테스트를 시작합니다...\n" + "-"*40)

    try:
        # 클라이언트 초기화 (환경 변수에서 자동으로 키를 읽어옵니다)
        client = Anthropic(api_key=os.environ.get("ANTHROPIC_API_KEY"))

        # 최신 모델(Claude 3.5 Sonnet)에 가벼운 질문 던지기
        response = client.messages.create(
            model="claude-3-haiku-20240307",
            max_tokens=100,
            messages=[
                {"role": "user", "content": "안녕? 네가 정상적으로 작동하는지 테스트 중이야. 딱 한 문장으로 짧게 인사해줄래?"}
            ]
        )

        # 성공 시 응답 출력
        print("✅ [통신 성공] 클로드의 답변이 도착했습니다:\n")
        print(f"🤖 Claude: {response.content[0].text}")

    except AuthenticationError:
        # 401 에러 (키 불일치)
        print("❌ [인증 실패] API 키가 잘못되었거나 유효하지 않습니다.")
        print("   - sk-ant- 로 시작하는 키가 맞는지, 앞뒤에 공백이 들어가지 않았는지 확인해 주세요.")

    except Exception as e:
        # 기타 에러 (크레딧 부족 등)
        print(f"⚠️ [기타 오류 발생] 상세 내역: {e}")

# 테스트 실행
test_claude_api()

### OpenAI 키 API 테스트용 코드

def test_openai_api():
    print("🔍 OpenAI API 통신 테스트를 시작합니다...\n" + "-"*40)

    try:
        # 클라이언트 초기화 (환경 변수에서 자동으로 키를 읽어옵니다)
        client = OpenAI(api_key=os.environ.get("OPENAI_API_KEY"))

        # 최신 주력 모델(gpt-4o)에 가벼운 질문 던지기
        response = client.chat.completions.create(
            model="gpt-4o",
            max_tokens=100,
            messages=[
                {"role": "user", "content": "안녕? 네가 정상적으로 작동하는지 테스트 중이야. 딱 한 문장으로 짧게 인사해줄래?"}
            ]
        )

        # 성공 시 응답 출력
        print("✅ [통신 성공] GPT의 답변이 도착했습니다:\n")
        print(f"🤖 GPT-4o: {response.choices[0].message.content}")

    except AuthenticationError:
        # 401 에러 (키 불일치)
        print("❌ [인증 실패 (401)] API 키가 잘못되었거나 유효하지 않습니다.")
        print("   - sk-proj- 로 시작하는 키가 맞는지, 앞뒤에 공백이 들어가지 않았는지 확인해 주세요.")

    except RateLimitError:
        # 429 에러 (할당량 초과 또는 잔액 부족)
        print("⚠️ [할당량 초과 (429)] API 키는 맞지만, 계정의 무료 제공량이 소진되었거나 결제 잔액이 없습니다.")
        print("   - OpenAI 플랫폼(platform.openai.com)에서 Billing(결제) 상태를 확인해 주세요.")

    except Exception as e:
        # 기타 네트워크 에러 등
        print(f"🚨 [기타 오류 발생] 상세 내역: {e}")

# 테스트 실행
test_openai_api()