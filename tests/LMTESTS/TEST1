

# --- [3-1] 통합 검색 도구(Tool) 정의 ---
def search_integrated_risk(company_name: str, stock_code: str) -> str:
    """
    OpenDART(공시), Naver(뉴스), Tavily(웹)를 통합하여 기업의 리스크를 검색합니다.
    """
    import datetime
    import requests

    combined_results = []
    six_months_ago = (datetime.datetime.now() - datetime.timedelta(days=180)).strftime('%Y%m%d')
    today = datetime.datetime.now().strftime('%Y%m%d')

    # 1. OpenDART 공식 공시 목록 검색
    try:
        dart_url = "https://opendart.fss.or.kr/api/list.json"
        dart_params = {"crtfc_key": OPENDART_API_KEY, "corp_code": stock_code, "bgn_de": six_months_ago, "end_de": today, "page_count": "30"}
        dart_res = requests.get(dart_url, params=dart_params)
        if dart_res.status_code == 200 and dart_res.json().get('status') == '000':
            noteworthy_filings = []
            risk_keywords = ['소송', '횡령', '배임', '유상증자', '감사', '부도', '회생', '벌금', '과징금']
            for item in dart_res.json().get('list', []):
                if any(kw in item.get('report_nm', '') for kw in risk_keywords):
                    noteworthy_filings.append(f"- [{item['pblntf_dt']}] {item['report_nm']}")
            if noteworthy_filings:
                combined_results.append("=== [OpenDART 공식 리스크 공시] ===")
                combined_results.extend(noteworthy_filings)
            else:
                combined_results.append("=== [OpenDART] 최근 6개월 주요 리스크 공시 없음 ===")
    except Exception as e:
        combined_results.append(f"OpenDART 오류: {str(e)}")

    # 2. 네이버 뉴스 검색
    try:
        naver_url = "https://openapi.naver.com/v1/search/news.json"
        naver_headers = {"X-Naver-Client-Id": NAVER_CLIENT_ID, "X-Naver-Client-Secret": NAVER_CLIENT_SECRET}
        naver_res = requests.get(naver_url, headers=naver_headers, params={"query": f"{company_name} 리스크 소송 횡령 배임", "display": 3, "sort": "date"})
        if naver_res.status_code == 200 and naver_res.json().get('items'):
            combined_results.append("\n=== [Naver News 최신 이슈] ===")
            for item in naver_res.json().get('items'):
                title = item['title'].replace('<b>', '').replace('</b>', '').replace('&quot;', '')
                combined_results.append(f"- {title}")
    except Exception as e:
        combined_results.append(f"네이버 오류: {str(e)}")

    # 3. Tavily 웹 검색
    try:
        tavily_url = "https://api.tavily.com/search"
        tavily_payload = {"api_key": TAVILY_API_KEY, "query": f"{company_name} legal litigation risk", "max_results": 2}
        t_res = requests.post(tavily_url, json=tavily_payload)
        if t_res.status_code == 200 and t_res.json().get('results'):
            combined_results.append("\n=== [Tavily Web Insights] ===")
            for item in t_res.json().get('results'):
                combined_results.append(f"- {item.get('title')}: {item.get('content')[:100]}...")
    except Exception as e:
        combined_results.append(f"Tavily 오류: {str(e)}")

    return "\n".join(combined_results) if combined_results else "검색 결과가 없습니다."


# --- [3-2] 독립 로거 타겟팅이 추가된 궁극의 Failover 로직 ---

class AgnoErrorInterceptor(logging.Handler):
    def __init__(self):
        super().__init__()
        self.has_error = False
        self.error_messages = []

    def emit(self, record):
        if record.levelno >= logging.ERROR:
            self.has_error = True
            self.error_messages.append(record.getMessage())

def run_analysis_with_failover(query: str, primary_agent: Agent, backup_agent: Agent):
    print(f"🔍 [1순위 모델] {primary_agent.name} 호출 중...\n")

    error_catcher = AgnoErrorInterceptor()

    # 💡 [핵심 수정] 루트 로거가 아닌 Agno와 관련된 모든 하위 로거를 직접 멱살잡고 감시합니다.
    target_loggers = [logging.getLogger(), logging.getLogger("agno"), logging.getLogger("phidata"), logging.getLogger("rich")]
    for logger in target_loggers:
        logger.addHandler(error_catcher)

    try:
        primary_stream = primary_agent.run(query, stream=True)
        content_yielded_primary = False
        full_content = ""

        for chunk in primary_stream:
            if chunk.content:
                print(chunk.content, end="", flush=True)
                full_content += chunk.content
                content_yielded_primary = True

        # 1. 시스템 백그라운드 에러 로그 감지 시
        if error_catcher.has_error:
            raise ValueError(f"내부 시스템 에러 탐지: {error_catcher.error_messages[0]}")

        # 2. Agno가 로그마저 우회하고 스트리밍 텍스트로 대놓고 HTTP 에러 코드를 뱉어낼 때의 최후의 안전망
        if full_content.strip().startswith("Error code: 40") or full_content.strip().startswith("Error code: 50"):
            raise ValueError(f"API 에러 코드가 직접 출력됨: {full_content.strip()}")

        if not content_yielded_primary:
            raise ValueError(f"{primary_agent.name}의 유효한 응답이 반환되지 않았습니다.")

        print(f"\n\n✅ {primary_agent.name} 분석 성공.")
        return

    except Exception as e_primary:
        print(f"\n\n❌ [장애 감지] 1순위 모델({primary_agent.name}) 작동 실패: {e_primary}")
        print(f"🔄 백업 모델({backup_agent.name})로 즉시 전환합니다...\n" + "="*50 + "\n")

        # 인터셉터 초기화
        error_catcher.has_error = False
        error_catcher.error_messages.clear()

        try:
            backup_stream = backup_agent.run(query, stream=True)
            content_yielded_backup = False
            full_content_backup = ""

            for chunk in backup_stream:
                if chunk.content:
                    print(chunk.content, end="", flush=True)
                    full_content_backup += chunk.content
                    content_yielded_backup = True

            if error_catcher.has_error:
                raise ValueError(f"내부 시스템 에러 탐지: {error_catcher.error_messages[0]}")

            if full_content_backup.strip().startswith("Error code: 40") or full_content_backup.strip().startswith("Error code: 50"):
                raise ValueError(f"API 에러 코드가 직접 출력됨: {full_content_backup.strip()}")

            if not content_yielded_backup:
                raise ValueError(f"{backup_agent.name}의 유효한 응답이 반환되지 않았습니다.")

            print(f"\n\n✅ {backup_agent.name} 장애 복구 및 분석 성공.")
            return

        except Exception as e_backup:
            print(f"\n\n🚨 [치명적 오류] 1순위와 2순위 모델이 모두 실패했습니다!")
            print(f"   - 1순위 에러 사유: {e_primary}")
            print(f"   - 2순위 에러 사유: {e_backup}")
            print("\n🚫 파이프라인 중단: 두 API의 키 상태, 요금 한도, 또는 모델명을 점검해 주세요.")
    finally:
        # 정상 작동이든 실패든, 메모리 누수 방지를 위해 부착했던 인터셉터 모두 회수
        for logger in target_loggers:
            logger.removeHandler(error_catcher)


